{
  "name": "zido",
  "version": "0.0.1",
  "description": "Zido is unifies Kakao, Naver, and Google Maps for place search and geocoding, with ordered provider fallback.",
  "author": "miyu4u",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "npm run build:http && npm run build:stdio && npm run build:cli",
    "build:cli": "nest build zido-cli",
    "build:http": "nest build zido-http-server",
    "build:stdio": "nest build zido-stdio-server",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start zido-http-server",
    "start:cli": "node dist/apps/cli/main.js",
    "start:dev": "nest start zido-http-server --watch",
    "start:stdio": "nest start zido-stdio-server",
    "start:http": "nest start zido-http-server",
    "start:prod": "node dist/apps/http-server/main.js",
    "start:prod:cli": "node dist/apps/cli/main.js",
    "start:prod:http": "node dist/apps/http-server/main.js",
    "start:prod:stdio": "node dist/apps/stdio-server/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "node --disable-warning=ExperimentalWarning --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --disable-warning=ExperimentalWarning --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --disable-warning=ExperimentalWarning --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --disable-warning=ExperimentalWarning --experimental-vm-modules --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:providers": "node --disable-warning=ExperimentalWarning --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand test/providers.spec.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "webpack": "^5.111.1",
    "webpack-node-externals": "^3.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/http-server/src/",
      "<rootDir>/apps/http-server/test/",
      "<rootDir>/apps/stdio-server/src/",
      "<rootDir>/apps/stdio-server/test/",
      "<rootDir>/apps/cli/",
      "<rootDir>/libs/",
      "<rootDir>/test/"
    ],
    "moduleNameMapper": {
      "^zido/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^zido/map-providers(|/.*)$": "<rootDir>/libs/map-providers/src/$1",
      "^zido/mcp-runtime(|/.*)$": "<rootDir>/libs/mcp-runtime/src/$1",
      "^zido/place-domain(|/.*)$": "<rootDir>/libs/place-domain/src/$1"
    }
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "arrowParens": "always",
    "printWidth": 120,
    "tabWidth": 2,
    "useTabs": false,
    "semi": false,
    "bracketSpacing": true
  }
}
