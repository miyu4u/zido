{
  "name": "zido",
  "version": "1.0.0",
  "description": "MCP 서버 for 지도 검색 (카카오/네이버/구글)",
  "main": "dist/stdio.js",
  "scripts": {
    "dev:stdio": "tsx src/app/stdio.ts",
    "dev:http": "tsx src/app/http.ts",
    "build": "tsup src/app/stdio.ts src/app/http.ts --format cjs --dts",
    "start:stdio": "node dist/stdio.js",
    "start:http": "node dist/http.js",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "mcp",
    "map",
    "geocoding"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "pino": "^8.16.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "esbuild": "^0.19.11",
    "prettier": "^3.7.4",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "arrowParens": "always",
    "printWidth": 120,
    "tabWidth": 4,
    "useTabs": false,
    "endOfLine": "lf",
    "semi": false
  }
}