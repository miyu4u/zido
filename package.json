{
  "name": "zido",
  "version": "0.0.1",
  "description": "Zido is unifies Kakao, Naver, and Google Maps for place search and geocoding, with ordered provider fallback.",
  "author": "miyu4u",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "npm run build:http && npm run build:stdio && npm run build:cli",
    "build:cli": "nest build zido-cli",
    "build:http": "nest build zido-http-server",
    "build:stdio": "nest build zido-stdio-server",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start zido-http-server",
    "start:cli": "node dist/apps/cli/main.js",
    "start:dev": "nest start zido-http-server --watch",
    "start:stdio": "nest start zido-stdio-server",
    "start:http": "nest start zido-http-server",
    "start:prod": "node dist/apps/http-server/main.js",
    "start:prod:cli": "node dist/apps/cli/main.js",
    "start:prod:http": "node dist/apps/http-server/main.js",
    "start:prod:stdio": "node dist/apps/stdio-server/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:providers": "jest --runInBand test/providers.spec.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "axios": "^1.18.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/http-server/src/",
      "<rootDir>/apps/http-server/test/",
      "<rootDir>/apps/stdio-server/src/",
      "<rootDir>/apps/stdio-server/test/",
      "<rootDir>/apps/cli/",
      "<rootDir>/libs/",
      "<rootDir>/test/"
    ],
    "moduleNameMapper": {
      "^zido/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^zido/map-providers(|/.*)$": "<rootDir>/libs/map-providers/src/$1",
      "^zido/mcp-runtime(|/.*)$": "<rootDir>/libs/mcp-runtime/src/$1",
      "^zido/place-domain(|/.*)$": "<rootDir>/libs/place-domain/src/$1",
      "^zido/charger-domain(|/.*)$": "<rootDir>/libs/charger-domain/src/$1",
      "^zido/charger-providers(|/.*)$": "<rootDir>/libs/charger-providers/src/$1",
      "^zido/charger-storage(|/.*)$": "<rootDir>/libs/charger-storage/src/$1"
    }
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "arrowParens": "always",
    "printWidth": 120,
    "tabWidth": 2,
    "useTabs": false,
    "semi": false,
    "bracketSpacing": true
  }
}
