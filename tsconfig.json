{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "types": ["node", "jest"],
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "./dist",

    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "strictPropertyInitialization": false,
    "paths": {
      "zido/common": [
        "./libs/common/src"
      ],
      "zido/common/*": [
        "./libs/common/src/*"
      ],
      "zido/map-providers": [
        "./libs/map-providers/src"
      ],
      "zido/map-providers/*": [
        "./libs/map-providers/src/*"
      ],
      "zido/mcp-runtime": [
        "./libs/mcp-runtime/src"
      ],
      "zido/mcp-runtime/*": [
        "./libs/mcp-runtime/src/*"
      ],
      "zido/place-domain": [
        "./libs/place-domain/src"
      ],
      "zido/place-domain/*": [
        "./libs/place-domain/src/*"
      ],
      "zido/charger-domain": [
        "./libs/charger-domain/src"
      ],
      "zido/charger-domain/*": [
        "./libs/charger-domain/src/*"
      ],
      "zido/charger-providers": [
        "./libs/charger-providers/src"
      ],
      "zido/charger-providers/*": [
        "./libs/charger-providers/src/*"
      ],
      "zido/charger-storage": [
        "./libs/charger-storage/src"
      ],
      "zido/charger-storage/*": [
        "./libs/charger-storage/src/*"
      ]
    }
  }
}