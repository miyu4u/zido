{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "zido/configuration": [
        "libs/configuration/src"
      ],
      "zido/configuration/*": [
        "libs/configuration/src/*"
      ],
      "zido/map-providers": [
        "libs/map-providers/src"
      ],
      "zido/map-providers/*": [
        "libs/map-providers/src/*"
      ],
      "zido/mcp-runtime": [
        "libs/mcp-runtime/src"
      ],
      "zido/mcp-runtime/*": [
        "libs/mcp-runtime/src/*"
      ],
      "zido/place-domain": [
        "libs/place-domain/src"
      ],
      "zido/place-domain/*": [
        "libs/place-domain/src/*"
      ]
    }
  }
}