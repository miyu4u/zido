{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "prefix": "zido",
  "sourceRoot": "apps/http-server/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "webpackConfigPath": "webpack.config.js"
  },
  "projects": {
    "zido-http-server": {
      "type": "application",
      "root": "apps/http-server",
      "entryFile": "main",
      "sourceRoot": "apps/http-server/src",
      "compilerOptions": {
        "tsConfigPath": "apps/http-server/tsconfig.app.json"
      }
    },
    "zido-stdio-server": {
      "type": "application",
      "root": "apps/stdio-server",
      "entryFile": "main",
      "sourceRoot": "apps/stdio-server/src",
      "compilerOptions": {
        "tsConfigPath": "apps/stdio-server/tsconfig.app.json"
      }
    },
    "zido-cli": {
      "type": "application",
      "root": "apps/cli",
      "entryFile": "main",
      "sourceRoot": "apps/cli/src",
      "compilerOptions": {
        "tsConfigPath": "apps/cli/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "map-providers": {
      "type": "library",
      "root": "libs/map-providers",
      "entryFile": "index",
      "sourceRoot": "libs/map-providers/src",
      "compilerOptions": {
        "tsConfigPath": "libs/map-providers/tsconfig.lib.json"
      }
    },
    "mcp-runtime": {
      "type": "library",
      "root": "libs/mcp-runtime",
      "entryFile": "index",
      "sourceRoot": "libs/mcp-runtime/src",
      "compilerOptions": {
        "tsConfigPath": "libs/mcp-runtime/tsconfig.lib.json"
      }
    },
    "place-domain": {
      "type": "library",
      "root": "libs/place-domain",
      "entryFile": "index",
      "sourceRoot": "libs/place-domain/src",
      "compilerOptions": {
        "tsConfigPath": "libs/place-domain/tsconfig.lib.json"
      }
    },
    "charger-domain": {
      "type": "library",
      "root": "libs/charger-domain",
      "entryFile": "index",
      "sourceRoot": "libs/charger-domain/src",
      "compilerOptions": {
        "tsConfigPath": "libs/charger-domain/tsconfig.lib.json"
      }
    },
    "charger-providers": {
      "type": "library",
      "root": "libs/charger-providers",
      "entryFile": "index",
      "sourceRoot": "libs/charger-providers/src",
      "compilerOptions": {
        "tsConfigPath": "libs/charger-providers/tsconfig.lib.json"
      }
    },
    "charger-storage": {
      "type": "library",
      "root": "libs/charger-storage",
      "entryFile": "index",
      "sourceRoot": "libs/charger-storage/src",
      "compilerOptions": {
        "tsConfigPath": "libs/charger-storage/tsconfig.lib.json"
      }
    }
  }
}