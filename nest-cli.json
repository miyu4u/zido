{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "prefix": "zido",
  "sourceRoot": "apps/zido-http-server/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true
  },
  "projects": {
    "zido-http-server": {
      "type": "application",
      "root": "apps/zido-http-server",
      "entryFile": "main",
      "sourceRoot": "apps/zido-http-server/src",
      "compilerOptions": {
        "tsConfigPath": "apps/zido-http-server/tsconfig.app.json"
      }
    },
    "zido-stdio-server": {
      "type": "application",
      "root": "apps/zido-stdio-server",
      "entryFile": "main",
      "sourceRoot": "apps/zido-stdio-server/src",
      "compilerOptions": {
        "tsConfigPath": "apps/zido-stdio-server/tsconfig.app.json"
      }
    },
    "zido-cli": {
      "type": "application",
      "root": "apps/zido-cli",
      "entryFile": "main",
      "sourceRoot": "apps/zido-cli/src",
      "compilerOptions": {
        "tsConfigPath": "apps/zido-cli/tsconfig.app.json"
      }
    },
    "configuration": {
      "type": "library",
      "root": "libs/configuration",
      "entryFile": "index",
      "sourceRoot": "libs/configuration/src",
      "compilerOptions": {
        "tsConfigPath": "libs/configuration/tsconfig.lib.json"
      }
    },
    "map-providers": {
      "type": "library",
      "root": "libs/map-providers",
      "entryFile": "index",
      "sourceRoot": "libs/map-providers/src",
      "compilerOptions": {
        "tsConfigPath": "libs/map-providers/tsconfig.lib.json"
      }
    },
    "mcp-runtime": {
      "type": "library",
      "root": "libs/mcp-runtime",
      "entryFile": "index",
      "sourceRoot": "libs/mcp-runtime/src",
      "compilerOptions": {
        "tsConfigPath": "libs/mcp-runtime/tsconfig.lib.json"
      }
    },
    "place-domain": {
      "type": "library",
      "root": "libs/place-domain",
      "entryFile": "index",
      "sourceRoot": "libs/place-domain/src",
      "compilerOptions": {
        "tsConfigPath": "libs/place-domain/tsconfig.lib.json"
      }
    }
  }
}