# Zido MCP Server 환경변수 설정

# MCP 서버 설정
MCP_SERVER_NAME=zido
MCP_SERVER_VERSION=1.0.0
MCP_HTTP_PORT=8000

# CORS 허용 출처 (쉼표로 구분)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Provider 우선순위 (쉼표로 구분)
# 예: kakao,naver,google
PROVIDER_ORDER=kakao,naver,google

# Kakao Local API
# 발급: https://developers.kakao.com/console/app
KAKAO_REST_KEY=your_kakao_rest_api_key_here

# Naver Local API (선택)
# 발급: https://developers.naver.com/apps/#/register
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# Google Maps API (선택)
GOOGLE_API_KEY=your_google_api_key_here

KECO_API_KEY=keco_api_key_here
KECO_API_URL=https://apis.data.go.kr/B552584/EvCharger
KECO_API_TIMEOUT=8000
# 주변 검색의 기본 수집 지역 집합(KECO 2자리 시·도 코드, comma-separated)
CHARGER_DEFAULT_REGION_CODES=11
# 전국 수집은 기본 비활성화하며 호출별 acknowledge와 함께 true일 때만 허용
CHARGER_ALLOW_NATIONWIDE_COLLECTION=false